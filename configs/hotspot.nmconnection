[connection]
id=hotspot
uuid=4e35e5da-f566-46e1-9d90-8bdc0adde58f
type=wifi
autoconnect=true
interface-name=wlan0
master=br0
slave-type=bridge

[wifi]
band=bg
channel=1
mode=ap
ssid=Openstick

[wifi-security]
group=ccmp;
key-mgmt=wpa-psk
pairwise=ccmp;
proto=rsn;
psk=openstick

[ipv4]
method=disabled

[ipv6]
addr-gen-mode=default
method=disabled

[proxy]
